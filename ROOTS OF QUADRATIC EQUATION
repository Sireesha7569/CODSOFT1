import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int b = sc.nextInt();
        int c = sc.nextInt();
        int d = b * b - 4 * a * c; 

        if (d < 0) {
            System.out.println("No roots"); 
        } else {
            double r1 = (-b + Math.sqrt(d)) / (2 * a);
            double r2 = (-b - Math.sqrt(d)) / (2 * a);
            
            if (d == 0) {
                System.out.println(r1); 
            } else {
                System.out.println(r1);
                System.out.println(r2);
            }
        }
    }
}
